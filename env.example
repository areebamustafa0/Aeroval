# AEROVÉL environment template
# This file is safe to share: it contains NO working credentials.
# Copy it to .env in the SAME FOLDER as package.json, then edit .env.

# Option A — local PostgreSQL (edit username/password to match your PC):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/aerovel_db"
# Option B — Neon: comment out Option A and use YOUR pooled connection string:
# DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require"

# Required: generate once on your PC with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-this-with-a-generated-random-secret"

# Optional S3 / Neon Object Storage for archiving PDF tickets.
# Leave empty for local development; PDF downloads still work.
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
# NEON_STORAGE_BUCKET="aerovel-tickets"
